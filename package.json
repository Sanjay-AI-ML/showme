{
  "name": "showme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "node scripts/embed-widget-assets.mjs && tsc --noEmit && tsc -p tsconfig.server.json && vite build && tsc -p tsconfig.sdk.json && vite build --config vite.embed.config.ts && node scripts/copy-sdk-assets.mjs",
    "start": "node dist/server/index.js",
    "test": "tsx --test server/*.test.ts sdk/*.test.ts examples/*.test.ts",
    "smoke:production": "npm run build && tsx scripts/production-smoke.ts",
    "backup": "node dist/scripts/backup.js",
    "backup:dev": "tsx scripts/backup.ts",
    "validation:report": "tsx scripts/validation-report.ts",
    "smoke:text": "tsx scripts/smoke-text.ts",
    "smoke:profile-text": "tsx scripts/smoke-profile-text.ts",
    "smoke:widget-text": "tsx scripts/smoke-widget-text.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
